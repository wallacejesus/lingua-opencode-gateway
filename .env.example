# ============================================================
# Upstream provider API keys
# ============================================================

OPENCODE_API_KEY=your-opencode-zen-key
OPENCODE_GO_API_KEY=your-opencode-go-key
OPENROUTER_API_KEY=your-openrouter-key
DEEPSEEK_API_KEY=your-deepseek-key
GOOGLE_API_KEY=your-google-key
ORCAROUTER_API_KEY=your-orcarouter-key


# ============================================================
# Local Lingua Gateway
# ============================================================

# API key that OpenCode will use when calling your local gateway
GATEWAY_API_KEY=sk-local-lingua

# Port exposed on your machine
GATEWAY_PORT=4000


# ============================================================
# Lingua / LLMLingua-2
# ============================================================

# CPU is the safest default
LINGUA_DEVICE=cpu

# Compression model
LINGUA_MODEL_NAME_ID=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank

# Set to 1 only if the model is already present in the Hugging Face cache
HF_HUB_OFFLINE=0
